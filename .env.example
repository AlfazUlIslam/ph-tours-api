PORT=your_port
MONGODB_URI=your_mongodb_uri
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRY=your_jwt_expiry
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRY=your_jwt_refresh_expiry

# BCRYPT
BCRYPT_SALT_ROUND=your_bcrypt_salt_round

# SUPER ADMIN
SUPER_ADMIN_EMAIL=your_super_admin_email
SUPER_ADMIN_PASSWORD=your_super_admin_password

# Google
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CALLBACK_URL=your_callback_url

# Express Session
EXPRESS_SESSION_SECRET=your_express_session_secret

# Frontend URL
FRONTEND_URL=http://localhost:5173

# SSLCommerz
SSL_STORE_ID="your_ssl_store_id"
SSL_STORE_PASS="your_ssl_store_pass"
SSL_PAYMENT_API="your_ssl_payment_api"
SSL_VALIDATION_API="your_ssl_validation_api"

# SSLCommerz Backend URL's
SSL_SUCCESS_BACKEND_URL="http:localhost:your-port/api/v1/payment/success"
SSL_FAIL_BACKEND_URL="http:localhost:your-port/api/v1/payment/fail"
SSL_CANCEL_BACKEND_URL="http:localhost:your-port/api/v1/payment/cancel"

# SSLCommerz Frontend URL's
SSL_SUCCESS_FRONTEND_URL="http://localhost:your-port/payment/success"
SSL_FAIL_FRONTEND_URL="http://localhost:your-port/payment/fail"
SSL_CANCEL_FRONTEND_URL="http://localhost:your-port/payment/cancel"